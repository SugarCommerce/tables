{
  "name": "@sugarcommerce/tables",
  "version": "1.0.0",
  "private": true,
  "description": "The list tables' scripts -- reordering rows, Quick and Bulk Edit, toggle cells and deferred columns -- built to assets/build with @wordpress/scripts.",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "build": "wp-scripts build reorder=./src/js/reorder.js inline-edit=./src/js/inline-edit.js toggle=./src/js/toggle.js deferred-columns=./src/js/deferred-columns.js --output-path=assets/build",
    "start": "wp-scripts start reorder=./src/js/reorder.js inline-edit=./src/js/inline-edit.js toggle=./src/js/toggle.js deferred-columns=./src/js/deferred-columns.js --output-path=assets/build",
    "test:js": "wp-scripts test-unit-js",
    "lint:js": "wp-scripts lint-js src/js tests/js",
    "format:js": "wp-scripts format src/js tests/js"
  },
  "devDependencies": {
    "@wordpress/a11y": "^5.2.0",
    "@wordpress/dom-ready": "^5.1.0",
    "@wordpress/scripts": "~37.1.0",
    "globals": "^16.5.0",
    "jsdom": "~30.1.3",
    "vite": "~8.1.7",
    "vitest": "~5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
